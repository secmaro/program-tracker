# Program Tracker — env vars template
# Copy to .env, fill in values, never commit the real .env

# Required:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — leave blank on first deploy. The bot creates a Gist on first run
# and sends the ID to your Telegram chat. Copy that ID here and redeploy.
GIST_ID=

# Optional tuning:
CHECK_INTERVAL_MINUTES=15
# DATA_SOURCE_URL=https://raw.githubusercontent.com/projectdiscovery/public-bugbounty-programs/main/chaos-bugbounty-list.json
# USER_AGENT=ProgramTracker/1.0
